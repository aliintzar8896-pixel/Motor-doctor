# Motor Doctor Backend Environment Variables
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://motordoctor.in

# Payment Gateway (Optional / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# External Database (Optional / Production - e.g. MongoDB or PostgreSQL URI)
DATABASE_URL=

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
