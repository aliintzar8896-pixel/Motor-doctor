# Motor Doctor Backend Environment Variables
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://enchanting-clafoutis-d2ca0b.netlify.app,https://motordoctor.in

# Payment Gateway (Optional / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# External Database (Optional / Production - e.g. MongoDB or PostgreSQL URI)
DATABASE_URL=

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer SMTP Email Notifications (for Admin Alerts to Intzar Ali)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="Motor Doctor 24x7" <your_email@gmail.com>
# ADMIN_EMAIL=aliintzar8896@gmail.com
# ADMIN_NAME=Intzar Ali
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Motor Doctor 24x7" <no-reply@motordoctor.in>
ADMIN_EMAIL=aliintzar8896@gmail.com
ADMIN_NAME=Intzar Ali
